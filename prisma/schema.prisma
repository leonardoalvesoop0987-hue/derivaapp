generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum CardCategory {
  AZUL
  DERIVA
  ROSA
  ROXO
  VERMELHO
  PRETO
}

enum CardIntensity {
  LEVE
  QUENTE
  INTENSO
  PICO
}

enum DeckType {
  SYSTEM
  OFFICIAL
  COUPLE_CUSTOM
  CUSTOM
}

enum SessionMode {
  PADRAO
  ESTREIA
  PERSONALIZADO
  COM_PREFERENCIAS
  FAISCA
  MERGULHO
  NOITE_DELA
  FOCO_CATEGORIA
  TONS_ESCUROS
  NOITE_ESPECIAL
  CENA_SOLTA
}

enum CardTag {
  MASSAGEM
  TOQUE_LEVE
  TOQUE_INTIMO
  BEIJO
  RESPIRO
  CONEXAO
  COMANDO_DELA
  COMANDO_DELE
  CONTROLE_DELA
  CONTROLE_DELE
  FOCO_NELA
  FOCO_NELE
  FOCO_CASAL
  ORAL_NELA
  ORAL_NELE
  MAOS_NELA
  MAOS_NELE
  PENETRACAO
  SEM_PENETRACAO
  VIDEO
  FANTASIA
  ROLEPLAY
  PROVOCACAO
  PROIBICAO
  DIRTY_TALK
  IMAGINACAO
  TERCEIRO_IMAGINARIO
  COPIAR_ENERGIA
  DOMINANCIA_LEVE
  SUBMISSAO_LEVE
  PICO
  FECHAMENTO
}

enum SessionStage {
  OPENING
  WARMUP
  TEASING
  BUILDUP
  INTENSE
  PEAK
  COOLDOWN
  TRANSITION
  CLOSING
}

enum SessionFocus {
  BALANCED
  FOR_HER
  FOR_HIM
}

enum EroticFunction {
  PREPARO
  PROVOCACAO
  PRAZER_NELA
  PRAZER_NELE
  PRAZER_CASAL
  TRANSICAO
  RESPIRO
  FANTASIA
  VIDEO_ESTIMULO
  PICO
  FECHAMENTO
}

enum BodyFocus {
  GERAL
  BOCA
  MAOS
  CORPO
  GENITAL
  PENETRACAO
  MENTAL
  VISUAL
}

enum RecipientFocus {
  ELA
  ELE
  CASAL
  SORTEADO
}

enum ProgressionRole {
  ABRIR
  AQUECER
  PROVOCAR
  INTENSIFICAR
  SUSTENTAR
  PICO
  RESPIRAR
  FECHAR
}

enum SessionLength {
  CURTA
  MEDIA
  COMPLETA
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABORTED
}

enum SessionCardStatus {
  QUEUED
  SHOWN
  COMPLETED
  SKIPPED
}

enum FeedbackType {
  FAVORITE
  NEUTRAL
  NEVER_AGAIN
}

enum MediaType {
  VIDEO
  MUSIC
}

enum VideoCategory {
  LESBICO
  FFM
  MMF
  MF
}

enum VideoContentType {
  ORAL_ONLY
  PENETRATION_ONLY
  COMPLETE
}

enum MediaProcessingStatus {
  QUEUED
  UPLOADED
  PROCESSING
  READY
  ERROR
  DISABLED
}

enum MediaClassificationStatus {
  PENDING_CLASSIFICATION
  CLASSIFIED
}

enum MusicMood {
  RELAXANTE
  SENSUAL
  INTENSA
}

enum ReceiverRule {
  NONE
  WOMAN
  MAN
  ANY
}

enum ParticipantRole {
  WOMAN
  MAN
}

model User {
  id            String    @id @default(cuid())
  username      String?   @unique
  email         String?   @unique
  password_hash String
  is_admin      Boolean   @default(false)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  last_login_at DateTime?

  decks               Deck[]
  sessions            Session[]
  feedbacks           CardFeedback[]
  card_preferences    UserCardPreference[]
  preferences         UserPreference?
  participants        CoupleParticipant[]
  alignment_responses PrivateAlignmentResponse[]
  couple_unlocks      CoupleUnlock[]

  @@map("users")
}

model Deck {
  id                     String   @id @default(cuid())
  owner_user_id          String?
  created_by_admin_id    String?
  system_key             String?  @unique
  slug                   String?  @unique
  name                   String
  description            String?
  type                   DeckType
  is_default             Boolean  @default(false)
  is_active              Boolean  @default(true)
  requires_couple_unlock Boolean  @default(false)
  unlock_group_key       String?
  cover_style            String?
  back_design            String?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  owner        User?        @relation(fields: [owner_user_id], references: [id], onDelete: SetNull)
  unlock_group UnlockGroup? @relation(fields: [unlock_group_key], references: [key], onDelete: SetNull)
  cards        Card[]
  deck_cards   DeckCard[]
  sessions     Session[]

  @@map("decks")
}

model Card {
  id                     String        @id @default(cuid())
  deck_id                String
  system_key             String?       @unique
  category               CardCategory
  title                  String
  body                   String
  intensity              CardIntensity
  position               Int
  is_active              Boolean       @default(true)
  is_invertible          Boolean       @default(false)
  requires_video         Boolean       @default(false)
  receiver_rule          ReceiverRule?
  metadata_json          String?
  session_short_text     String?
  session_quick_tip      String?
  random_options_enabled Boolean       @default(false)
  persist_random_option  Boolean       @default(true)

  // Classificação Avançada
  primary_tag                CardTag?
  secondary_tags             CardTag[]        @default([])
  stage                      SessionStage?
  erotic_function            EroticFunction?
  body_focus                 BodyFocus?
  recipient_focus            RecipientFocus?
  progression_role           ProgressionRole?
  cooldown_allowed           Boolean          @default(false)
  closing_allowed            Boolean          @default(false)
  can_follow_heavy           Boolean          @default(false)
  requires_transition_before Boolean          @default(false)
  avoid_near_repetition      Boolean          @default(true)
  should_not_follow_tags     CardTag[]        @default([])
  should_not_precede_tags    CardTag[]        @default([])

  // Permissões e Desbloqueios
  requires_couple_unlock           Boolean @default(false)
  unlock_group_key                 String?
  is_available_in_default          Boolean @default(true)
  is_available_in_estreia          Boolean @default(true)
  is_available_in_custom_selection Boolean @default(true)
  is_official                      Boolean @default(true)
  admin_only_editable              Boolean @default(true)

  tags       CardTag[] @default([]) // Maintain legacy for now to avoid breaking changes immediately
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  deck           Deck                 @relation(fields: [deck_id], references: [id], onDelete: Cascade)
  unlock_group   UnlockGroup?         @relation(fields: [unlock_group_key], references: [key], onDelete: SetNull)
  session_cards  SessionCard[]
  deck_cards     DeckCard[]
  feedbacks      CardFeedback[]
  preferences    UserCardPreference[]
  video_options  SessionVideoOption[]
  voice_audios   CardVoiceAudio[]
  random_options CardRandomOption[]

  @@index([deck_id, position])
  @@map("cards")
}

model Session {
  id                   String        @id @default(cuid())
  user_id              String
  deck_id              String
  mode                 SessionMode
  length               SessionLength
  status               SessionStatus
  max_intensity        CardIntensity
  videos_enabled       Boolean       @default(true)
  music_enabled        Boolean       @default(true)
  target_card_count    Int
  current_position     Int           @default(0)
  last_card_id         String?
  completed_card_count Int           @default(0)
  skips_used           Int           @default(0)
  inversions_used      Int           @default(0)
  started_at           DateTime      @default(now())
  ended_at             DateTime?
  session_group_id     String?
  preferences_json     String?
  session_focus        SessionFocus  @default(FOR_HER)
  created_at           DateTime      @default(now())
  updated_at           DateTime      @updatedAt

  user          User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  deck          Deck                 @relation(fields: [deck_id], references: [id])
  cards         SessionCard[]
  feedbacks     CardFeedback[]
  video_options SessionVideoOption[]
  pace_events   SessionPaceEvent[]

  @@map("sessions")
}

model SessionCard {
  id                            String            @id @default(cuid())
  session_id                    String
  card_id                       String
  random_option_id              String?
  position                      Int
  status                        SessionCardStatus
  was_inverted                  Boolean           @default(false)
  is_inserted_pause             Boolean           @default(false)
  does_not_count_towards_target Boolean           @default(false)
  shown_at                      DateTime          @default(now())
  completed_at                  DateTime?
  skipped_at                    DateTime?
  metadata_json                 String?

  session       Session           @relation(fields: [session_id], references: [id], onDelete: Cascade)
  card          Card              @relation(fields: [card_id], references: [id])
  random_option CardRandomOption? @relation(fields: [random_option_id], references: [id], onDelete: SetNull)

  @@index([session_id, position])
  @@index([random_option_id])
  @@map("session_cards")
}

model CardRandomOption {
  id                String         @id @default(cuid())
  card_id           String
  label             String
  instruction_short String?
  instruction_full  String?
  weight            Int            @default(1)
  is_active         Boolean        @default(true)
  min_intensity     CardIntensity?
  max_intensity     CardIntensity?
  requires_unlock   Boolean        @default(false)
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  card          Card          @relation(fields: [card_id], references: [id], onDelete: Cascade)
  session_cards SessionCard[]

  @@index([card_id, is_active])
  @@map("card_random_options")
}

model CardFeedback {
  id            String       @id @default(cuid())
  user_id       String
  card_id       String
  session_id    String?
  feedback_type FeedbackType
  created_at    DateTime     @default(now())

  user    User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  card    Card     @relation(fields: [card_id], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [session_id], references: [id], onDelete: SetNull)

  @@map("card_feedback")
}

model UserCardPreference {
  id                 String        @id @default(cuid())
  user_id            String
  card_id            String
  is_favorite        Boolean       @default(false)
  is_removed         Boolean       @default(false)
  skip_count         Int           @default(0)
  favorite_count     Int           @default(0)
  last_feedback_type FeedbackType?
  last_seen_at       DateTime?
  last_skipped_at    DateTime?
  never_again_at     DateTime?
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@unique([user_id, card_id])
  @@map("user_card_preferences")
}

model MediaAsset {
  id                      String                    @id @default(cuid())
  type                    MediaType
  video_category          VideoCategory?
  content_type            VideoContentType?
  visual_tags             String[]
  music_mood              MusicMood?
  processing_status       MediaProcessingStatus     @default(READY)
  processing_error        String?
  classification_status   MediaClassificationStatus @default(CLASSIFIED)
  storage_key             String
  hls_master_key          String?
  thumbnail_key           String?
  bucket                  String?
  public_url              String?
  mime_type               String
  size_bytes              Int
  duration_seconds        Int?
  weight                  Int                       @default(1)
  is_active               Boolean                   @default(true)
  internal_label          String?
  original_filename       String?
  processing_started_at   DateTime?
  processing_heartbeat_at DateTime?
  processing_finished_at  DateTime?
  processing_owner        String?
  created_at              DateTime                  @default(now())
  updated_at              DateTime                  @updatedAt

  session_videos SessionVideoOption[]

  @@index([type, processing_status, created_at])
  @@index([type, processing_status, classification_status, is_active])
  @@index([processing_owner])
  @@map("media_assets")
}

model SessionVideoOption {
  id             String   @id @default(cuid())
  session_id     String
  card_id        String
  media_asset_id String
  draw_order     Int
  was_selected   Boolean  @default(false)
  was_skipped    Boolean  @default(false)
  created_at     DateTime @default(now())

  session     Session    @relation(fields: [session_id], references: [id], onDelete: Cascade)
  card        Card       @relation(fields: [card_id], references: [id], onDelete: Cascade)
  media_asset MediaAsset @relation(fields: [media_asset_id], references: [id], onDelete: Cascade)

  @@map("session_video_options")
}

model UserPreference {
  user_id                  String        @id
  videos_enabled_default   Boolean       @default(true)
  music_enabled_default    Boolean       @default(true)
  max_intensity_default    CardIntensity @default(PICO)
  preferred_session_length SessionLength @default(MEDIA)
  show_history             Boolean       @default(false)
  created_at               DateTime      @default(now())
  updated_at               DateTime      @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model CoupleParticipant {
  id         String          @id @default(cuid())
  user_id    String
  name       String
  email      String?
  role       ParticipantRole
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt

  user      User                       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  responses PrivateAlignmentResponse[]

  @@map("couple_participants")
}

model PrivateAlignmentResponse {
  id                String          @id @default(cuid())
  user_id           String
  participant_id    String
  participant_role  ParticipantRole
  form_type         String          @default("STANDARD_ALIGNMENT")
  version           Int
  questions_version String
  answers_json      String
  completed_at      DateTime?
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  user        User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  participant CoupleParticipant @relation(fields: [participant_id], references: [id], onDelete: Cascade)

  @@map("private_alignment_responses")
}

model UnlockGroup {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  couple_unlocks CoupleUnlock[]
  cards          Card[]
  decks          Deck[]

  @@map("unlock_groups")
}

model CoupleUnlock {
  id               String    @id @default(cuid())
  user_id          String
  unlock_group_key String
  is_enabled       Boolean   @default(false)
  enabled_at       DateTime?
  disabled_at      DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  user         User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  unlock_group UnlockGroup @relation(fields: [unlock_group_key], references: [key], onDelete: Cascade)

  @@unique([user_id, unlock_group_key])
  @@map("couple_unlocks")
}

model DeckCard {
  id         String   @id @default(cuid())
  deck_id    String
  card_id    String
  position   Int
  weight     Int      @default(1)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  deck Deck @relation(fields: [deck_id], references: [id], onDelete: Cascade)
  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@unique([deck_id, card_id])
  @@index([deck_id, position])
  @@map("deck_cards")
}

model AppSetting {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String?
  encrypted_value String?
  updated_at      DateTime @updatedAt

  @@map("app_settings")
}

model CardVoiceAudio {
  id              String   @id @default(cuid())
  card_id         String
  session_card_id String?
  provider        String
  voice_id        String
  text_hash       String
  text_used       String
  audio_url       String?
  r2_key          String?
  status          String   @default("PENDING") // PENDING, GENERATING, READY, ERROR
  error_message   String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@unique([provider, voice_id, card_id, text_hash])
  @@index([status])
  @@map("card_voice_audios")
}

model SessionPaceEvent {
  id          String   @id @default(cuid())
  session_id  String
  position    Int
  pace_choice String
  created_at  DateTime @default(now())

  session Session @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id])
  @@map("session_pace_events")
}
